{
  "expo": {
    "name": "TuVoto",
    "slug": "programas-electorales",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "es.programaselectorales.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es"
      }
    },
    "android": {
      "package": "es.programaselectorales.app",
      "adaptiveIcon": {
        "backgroundColor": "#161144",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "path": "/programas"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "path": "/programas/"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/tema"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/partido"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/ficha"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/buscar"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/cara-a-cara"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/test"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/vota"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/partidos"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/voto-correo"
            },
            {
              "scheme": "https",
              "host": "tuvoto.github.io",
              "pathPrefix": "/programas/documento"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "bundler": "metro",
      "name": "TuVoto",
      "description": "Compara por temas los programas electorales de las elecciones generales del 29 de noviembre de 2026.",
      "themeColor": "#161144",
      "backgroundColor": "#F6F4EF"
    },
    "experiments": {
      "baseUrl": "/programas"
    },
    "scheme": "programaselectorales",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notificacion.png",
          "color": "#161144"
        }
      ]
    ],
    "description": "Compara por temas los programas electorales de las elecciones generales del 29 de noviembre de 2026.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6fa9a3b-5933-447b-a509-82b6e9a79f51"
      }
    },
    "owner": "tuvoto",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d6fa9a3b-5933-447b-a509-82b6e9a79f51"
    }
  }
}
